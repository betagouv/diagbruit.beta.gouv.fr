REACT_APP_API_URL=http://localhost:8000
REACT_APP_CMS_URL=http://localhost:1337
REACT_APP_CONTACT_EMAIL=contact@diagbruit.fr
# "production" is the only indexable value (robots.txt allow + sitemap);
# preprod uses "test", local dev stays "development".
REACT_APP_ENVIRONMENT=development
# Public site origin, used for canonical URLs and the generated sitemap.xml.
# Set to the production domain in prod (e.g. https://diagbruit.beta.gouv.fr).
REACT_APP_SITE_URL=http://localhost:3000
